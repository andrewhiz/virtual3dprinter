// Cloudflare Workers config. The app is fully static, so there is no worker script:
// Workers serves the Vite build output in dist/ as static assets. Unknown paths get
// public/404.html with a real 404 status (the app has no client-side routes).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "virtual3dprinter",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true }
}
